# Copy to .env and fill in. .env is gitignored.

# Where the warehouse lives: local (data/warehouse/hc.duckdb) or motherduck (shared cloud DB)
DW_TARGET=local

# Only needed when DW_TARGET=motherduck or when running `hcdw push`
MOTHERDUCK_TOKEN=
MD_DATABASE=home_credit_dw

# Kaggle API token (Kaggle -> Settings -> API -> Create New Token), used by `hcdw download`.
# Alternative: the legacy ~/.kaggle/kaggle.json file.
KAGGLE_API_TOKEN=

# Optional overrides
# RAW_DIR=data/raw
# DW_PATH=data/warehouse/hc.duckdb
